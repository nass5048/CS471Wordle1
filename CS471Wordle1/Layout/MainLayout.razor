@inherits LayoutComponentBase
@using WordleAPI
@using WordleAPI.Classes
@using CS471Wordle1.Pages.Components
@using WordleBackend
@inject Login UserLogin
@inject NavigationManager NavigationManager
@inject Services.SpinnerService SpinnerService
@inject DataBase db
@inject HttpClient Http
@inject BrowserStorage BrowserStorage

<Spinner ShowSpinner="showSpinner" />
<div class="page">
    <div class="sidebar">
        <NavMenu LoggedIn="UserLogin.UserPermission != WordleBackend.Enums.Permission.Guest" />
    </div>

    <main>
        <div class="top-row px-4">
            <ReportBug />
            <div>@UserLogin.Username</div>
            @if (UserLogin.UserID ==0)
            {
                <button class="ml-auto" @onclick="GOTOLogin">Login</button>
            }
            else
            {
                <button class="ml-auto" @onclick="Logout">Logout</button>
            }
            
        </div>

        <article class="content px-4 parent">
            @Body
        </article>
    </main>
</div>
<style>
    .parent {
        position: relative; /* This "captures" the absolute child */
    }
</style>

@code{
    private bool showSpinner = false;
    public bool LoggedIn { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        await db.LoadData(Http);

        var storedId = await BrowserStorage.Get("userId");

        if (!string.IsNullOrEmpty(storedId))
        {
            long id = long.Parse(storedId);

            var user = db.Login.FirstOrDefault(x => x.UserID == id);

            if (user != null)
            {
                UserLogin.SetUserLogin(user);
            }
        }
        // initialize state and subscribe to changes
        showSpinner = SpinnerService.IsShowing;
        SpinnerService.OnChange += SpinnerChanged;
    }

    private void SpinnerChanged(bool showing)
    {
        showSpinner = showing;
        // ensure update on UI thread
        InvokeAsync(StateHasChanged);
    }

    // Backwards-compatible method (keeps your existing callers working)
    public Task ToggleSpinner(bool show)
    {
        SpinnerService.Toggle(show);
        return Task.CompletedTask;
    }

    // Unsubscribe to avoid memory leaks
    public void Dispose()
    {
        SpinnerService.OnChange -= SpinnerChanged;
    }
    
    void GOTOLogin()
    {
        StateHasChanged();
        NavigationManager.NavigateTo("/login");
        
    }
    async Task Logout()
    {
        UserLogin.SetUserLogin(new Login());
        LoggedIn = false;
        await BrowserStorage.Remove("userId");
        UserLogin.UserID = 0;
        UserLogin.Username = null;

        StateHasChanged();
        NavigationManager.NavigateTo("/");
        
	}
}