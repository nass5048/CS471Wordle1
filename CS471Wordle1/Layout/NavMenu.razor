@using WordleAPI.Classes
@using WordleBackend.Enums
@inject Login UserLogin

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">CS471Wordle1</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        @if (UserLogin.UserPermission == Permission.Guest || UserLogin.UserPermission == Permission.User)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="stats" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Stats
                </NavLink>
            </div>
        }
        
        @if(UserLogin.UserPermission == Permission.User)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="friends">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Friends
                </NavLink>
            </div>
        }
        @if (UserLogin.UserPermission == Permission.Admin || UserLogin.UserPermission == Permission.User)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="settings" Match="NavLinkMatch.All">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Settings
                </NavLink>
            </div>
        }
        @if(UserLogin.UserPermission == Permission.Admin)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin" Match="NavLinkMatch.All">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Admin
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="bugreport">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="white" class="bi bi-bug" viewBox="0 0 16 16">
                        <path d="M4.355.522a.5.5 0 0 1 .623.333l.291.956A5 5 0 0 1 8 1c1.007 0 1.946.298 2.731.811l.29-.956a.5.5 0 1 1 .957.29l-.41 1.352A5 5 0 0 1 13 6h.5a.5.5 0 0 0 .5-.5V5a.5.5 0 0 1 1 0v.5A1.5 1.5 0 0 1 13.5 7H13v1h1.5a.5.5 0 0 1 0 1H13v1h.5a1.5 1.5 0 0 1 1.5 1.5v.5a.5.5 0 1 1-1 0v-.5a.5.5 0 0 0-.5-.5H13a5 5 0 0 1-10 0h-.5a.5.5 0 0 0-.5.5v.5a.5.5 0 1 1-1 0v-.5A1.5 1.5 0 0 1 2.5 10H3V9H1.5a.5.5 0 0 1 0-1H3V7h-.5A1.5 1.5 0 0 1 1 5.5V5a.5.5 0 0 1 1 0v.5a.5.5 0 0 0 .5.5H3c0-1.364.547-2.601 1.432-3.503l-.41-1.352a.5.5 0 0 1 .333-.623M4 7v4a4 4 0 0 0 3.5 3.97V7zm4.5 0v7.97A4 4 0 0 0 12 11V7zM12 6a4 4 0 0 0-1.334-2.982A3.98 3.98 0 0 0 8 2a3.98 3.98 0 0 0-2.667 1.018A4 4 0 0 0 4 6z" />
                    </svg> Bugs
                </NavLink>
            </div>
        }
        @* <div class="nav-item px-3">
            <NavLink class="nav-link" href="signup">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> SignUp
            </NavLink>
        </div> *@
    </nav>
</div>

@code {
    [Parameter] public bool LoggedIn { get; set; }
    [Parameter] public EventCallback<bool> LoggedInChanged { get; set; }

    private async Task OnInputChanged(ChangeEventArgs e)
    {
        await LoggedInChanged.InvokeAsync((bool)e.Value);
        StateHasChanged();
    }


    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
