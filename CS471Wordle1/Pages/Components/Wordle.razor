@using System.Text.Json
@using WordleAPI
@using WordleAPI.Classes;
@using CS471Wordle1.Pages.Components
@using WordleBackend
@using WordleBackend.Classes
@using WordleBackend.Enums
@inject Services.SpinnerService SpinnerService
@inject Login UserLogin
@inject DataBase db
@inject ValidWords ValidWords
@inject HttpClient Http
@inject NavigationManager NavigationManager
@* @inject HttpClient Http *@

<PageTitle>Wordle</PageTitle>

@if (correctWord != null)
{
	<WordleKeyboardHost Solution=@correctWord OnGameCompleted="completeDaily" challenge="challenge" gameMode="gameMode"/>
	if((challenge == Challenge.None || challenge == Challenge.HardMode) && UseAI)
	{
		<div class="top-right">
			<RobotWordle Solution=@correctWord Hide=@HideRobot />
		</div>

	}
	@if (showContinue)
	{
		<button class="btn btn-success btn-sm me-2" @onclick="Continue">Continue</button>
	}
}
else
{
	<div class="text-center mt-5">
		@Error
	</div>

}
<style>
	.top-right {
		position: absolute;
		top: 20px;
		right: 20px;
		z-index: 9999;
	}

	
</style>

@code {
	// Selected game mode, challenge and if AI is enabled
	[Parameter]
	public GameMode gameMode { get; set; }
	[Parameter]
	public Challenge challenge { get; set; }
	[Parameter]
	public bool UseAI { get; set; }

	public string Error { get; set; } = "";

	private bool showContinue {get; set; } = false;

	// Current solution word and stores daily word info
	string? correctWord{ get;set; }
	WordResponse? dailyWord { get; set; }

	bool HideRobot { get; set; } = true;
	override protected async Task OnInitializedAsync()
	{
		SpinnerService.Show();
		await db.LoadData(Http);
		try
		{


			if (gameMode == GameMode.Daily)
			{
				var word = db.DailyWords.FirstOrDefault(w => w.Date == DateOnly.FromDateTime(DateTime.Today));
				if (word != default)
				{
					dailyWord = new WordResponse() { Solution = word.Word };
				}
				else
				{
					Error = "Sorry, not Daily Word has been set. Come again later.";
				}
			}
			else
			{
                await ValidWords.LoadValidWords(Http);
				var availableWords = ValidWords.AllWords.Where(w => w.CanUse).Select(w => w.Word).ToList();
				Random rand = new Random();

				dailyWord = new WordResponse() { Solution = availableWords[rand.Next(availableWords.Count())] };
			}
			var date = DateTime.Today.ToString("yyyy-MM-dd");
			if (dailyWord != null)
			{ 
				correctWord = dailyWord.Solution;
			}
		}
		catch (Exception ex)
		{
			Console.Error.WriteLine(ex);
		}

		//await stats.LoadAsync();
		SpinnerService.Hide();
	}

	// Stores solution word
	public class WordResponse
	{
		public string Solution { get; set; }
	}

	// When player completes the game
	public void completeDaily()
	{
		HideRobot = false;
		showContinue = true;

	}

	// Starts a new game or goes to home page
	public async Task Continue()
	{
		if (gameMode == GameMode.Daily)
		{
			NavigationManager.NavigateTo("/");
		}
		HideRobot = true;
		showContinue = false;
		correctWord = null;
		StateHasChanged();
		await OnInitializedAsync();
	}
}