@using WordleAPI.Classes
@using WordleBackend.Classes
@using WordleAPI
@using WordleBackend.Enums
@inject DataBase db
@inject HttpClient Http
@inject Login UserLogin
<div class="card shadow-sm border-0">
    <div class="card-body">

        <h4 class="fw-bold mb-3">
            @(IsFriendsOnly ? "Friends Leaderboard" : "Global Leaderboard")
        </h4>

        @if (leaderboard.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Username</th>
                            <th>Guesses</th>
                            <th>Time</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var entry in leaderboard.Select((x, i) => new { Rank = i + 1, Data = x }))
                        {
                            <tr>

                                <td>
                                    @if (entry.Rank == 1)
                                    {
                                        <span>🥇</span>
                                    }
                                    else if (entry.Rank == 2)
                                    {
                                        <span>🥈</span>
                                    }
                                    else if (entry.Rank == 3)
                                    {
                                        <span>🥉</span>
                                    }
                                    else
                                    {
                                        @entry.Rank
                                    }
                                </td>

                                <td>
                                    <strong>@entry.Data.Username</strong>
                                </td>

                                <td>@entry.Data.Guesses</td>

                                <td>@FormatTime(entry.Data.DailyWordTime)</td>

                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }
        else
        {
            <div class="alert alert-light text-center mb-0">
                No leaderboard data available.
            </div>
        }

    </div>
</div>
@code {
    [Parameter]
    public bool IsFriendsOnly { get; set; } = false;
    [Parameter]
    public string Style { get; set; } = "";
    private List<LeaderboardEntry> leaderboard = new();
    private HashSet<long> friendIDs = new();

    protected override async Task OnInitializedAsync()
    {
        await db.LoadData(Http);

        // Load friends if needed
        if (IsFriendsOnly)
            LoadFriends();

        // Build leaderboard
        leaderboard = db.Login
            .Where(x => x.UserStats.LastPlayed.HasValue &&
                        x.UserStats.LastPlayed.Value.Date == DateTime.Today &&
                        x.UserStats.DailyWordTime != null)
            .Select(s => new LeaderboardEntry
            {
                UserID = s.UserID,
                Username = s.Username,
                Guesses = (s.UserStats.DailyGuesses ?? new()).Count(g => g != null),
                DailyWordTime = s.UserStats.DailyWordTime?.TotalSeconds ?? 0
            })
            .Where(x => !IsFriendsOnly || friendIDs.Contains(x.UserID) || x.UserID == UserLogin.UserID)
            .OrderBy(x => x.Guesses)
            .ThenBy(x => x.DailyWordTime)
            .ToList();
    }

    private void LoadFriends()
    {
        friendIDs = db.FriendRequests
            .Where(r =>
                r.Status == FriendRequestStatus.Accepted &&
                (r.SenderID == UserLogin.UserID || r.ReceiverID == UserLogin.UserID))
            .Select(r => r.SenderID == UserLogin.UserID ? r.ReceiverID : r.SenderID)
            .ToHashSet();
    }

    private string FormatTime(double seconds)
    {
        TimeSpan t = TimeSpan.FromSeconds(seconds);
        return $"{t.Minutes:D2}:{t.Seconds:D2}";
    }

    public class LeaderboardEntry
    {
        public long UserID { get; set; }
        public string Username { get; set; }
        public int Guesses { get; set; }
        public double DailyWordTime { get; set; }
    }
}
