@using WordleBackend.Classes
@using WordleBackend.Enums
@using WordleAPI
@using WordleAPI.Classes
@inject Login UserLogin
@inject HttpClient Http
@inject DataBase db

<button class="btn btn-danger mb" @onclick="() => showModal = true">
    Report a Bug
</button>

@if (showModal)
{
    <div class="modal-backdrop" @onclick="CloseModal"></div>

    <div class="modal-container">
        <div class="modal-content">
            <h4>Report a Bug</h4>

            <label>Bug Type</label>
            <select class="form-select mb-2" @bind="newBug.Type">
                @foreach (var type in Enum.GetValues<BugType>())
                {
                    <option value="@type">@type</option>
                }
        </select>

            <label>Description</label>
            <textarea class="form-control mb-3" @bind="newBug.BugDescription"></textarea>

            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-danger flex-fill"
                        @onclick="SubmitBug">
                    Submit Report
                </button>

                <button class="btn btn-outline-secondary flex-fill"
                        @onclick="CloseModal">
                    Cancel
                </button>
            </div>
        </div>
    </div>
}
<style>
    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        z-index: 1000;
    }

    .modal-container {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 1001;
    }

    .modal-content {
        background: white;
        padding: 20px;
        width: 400px;
        border-radius: 8px;
        box-shadow: 0 0 10px black;
    }

</style>
@code {

    // Determines if bug report button is visable
    private bool showModal = false;

    // Stores info of submitted bug report 
    private BugReport newBug = new BugReport(); \

    // Submits bug report to the datatbase
    private async Task SubmitBug()
    {
        await db.LoadData(Http);

        newBug.UserID = UserLogin.UserID;

        db.BugReports.Add(new BugReport
        {
            UserID = newBug.UserID,
            Type = newBug.Type,
            BugDescription = newBug.BugDescription
        });

        await db.SaveData(Http);

        newBug = new BugReport();
        showModal = false;
    }

    private void CloseModal()
    {
        showModal = false;
    }

}
