@using WordleBackend.Classes
@using WordleBackend.Enums
@using WordleAPI
@using WordleAPI.Classes
@inject Login UserLogin
@inject HttpClient Http
@inject DataBase db

<button class="btn btn-danger mb-3" @onclick="() => showModal = true">
    Report a Bug
</button>

@if (showModal)
{
    <div class="modal-backdrop" @onclick="CloseModal"></div>

    <div class="modal-container">
        <div class="modal-content">
            <h4>Report a Bug</h4>

            <label>Bug Type</label>
            <select class="form-select mb-2" @bind="newBug.Type">
                @foreach (var type in Enum.GetValues<BugType>())
                {
                    <option value="@type">@type</option>
                }
        </select>

            <label>Description</label>
            <textarea class="form-control mb-3" @bind="newBug.BugDescription"></textarea>

            <button class="btn btn-primary me-2" @onclick="SubmitBug">Submit</button>
            <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
        </div>
    </div>
}
<style>
    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        z-index: 1000;
    }

    .modal-container {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 1001;
    }

    .modal-content {
        background: white;
        padding: 20px;
        width: 400px;
        border-radius: 8px;
        box-shadow: 0 0 10px black;
    }

</style>
@code {
    private bool showModal = false;
    private BugReport newBug = new BugReport();
    private async Task SubmitBug()
    {
        await db.LoadData(Http);

        newBug.UserID = UserLogin.UserID;

        db.BugReports.Add(new BugReport
        {
            UserID = newBug.UserID,
            Type = newBug.Type,
            BugDescription = newBug.BugDescription
        });

        await db.SaveData(Http);

        newBug = new BugReport();
        showModal = false;
    }

    private void CloseModal()
    {
        showModal = false;
    }

}
