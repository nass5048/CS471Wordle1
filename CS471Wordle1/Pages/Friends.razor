@page "/friends"
@using WordleAPI.Classes
@using WordleAPI
@using WordleBackend.Classes
@using WordleBackend.Enums
@inject Login UserLogin
@inject HttpClient Http
@inject DataBase db

<div class="d-flex justify-content-center mt-5">
    <div class="card p-4 shadow-lg border-0" style="width: 420px; border-radius: 15px;">

        <h2 class="text-center mb-4 fw-bold">Friends</h2>

        <!-- Search Section -->
        <div class="mb-4">
            <h5 class="fw-bold mb-3">Find Friends</h5>

            <div class="input-group">
                <input @bind="searchText"
                       placeholder="Search users..."
                       class="form-control" />
                <button class="btn btn-primary" @onclick="SearchUsers">
                    Search
                </button>
            </div>
        </div>

        @if (searchResults.Any())
        {
            <div class="mb-4">
                <h5 class="fw-bold mb-3">Search Results</h5>

                @foreach (var user in searchResults)
                {
                    <div class="card shadow-sm border-0 mb-2">
                        <div class="card-body d-flex justify-content-between align-items-center">

                            <div>
                                <strong>@user.Username</strong>
                            </div>

                            <div>
                                @if (IsAlreadyFriends(user.UserID))
                                {
                                    <span class="badge bg-success">
                                        Already Friends
                                    </span>
                                }
                                else if (HasPendingRequest(user.UserID))
                                {
                                    <span class="badge bg-warning text-dark">
                                        Request Pending
                                    </span>
                                }
                                else
                                {
                                    <button class="btn btn-success"
                                            @onclick="() => AddFriend(user)">
                                        Add Friend
                                    </button>
                                }
                            </div>

                        </div>
                    </div>
                }
            </div>
        }

        <hr />

        <!-- Friends List -->
        <div class="mb-4">
            <h5 class="fw-bold mb-3">Your Friends</h5>

            @if (friends.Any())
            {
                @foreach (var f in friends)
                {
                    <div class="card shadow-sm border-0 mb-2">
                        <div class="card-body">
                            <strong>@f.Username</strong>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-light text-center">
                    No friends yet.
                </div>
            }
        </div>

        <hr />

        <!-- Incoming Requests -->
        <div class="mb-4">
            <h5 class="fw-bold mb-3">Incoming Friend Requests</h5>

            @if (incomingRequests.Any())
            {
                @foreach (var req in incomingRequests)
                {
                    <div class="card shadow-sm border-0 mb-2">
                        <div class="card-body d-flex justify-content-between align-items-center">

                            <strong>@req.Username</strong>

                            <div>
                                <button class="btn btn-success me-2"
                                        @onclick="() => AcceptFriend(req)">
                                    Accept
                                </button>

                                <button class="btn btn-danger"
                                        @onclick="() => RejectFriend(req)">
                                    Reject
                                </button>
                            </div>

                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-light text-center">
                    No incoming requests.
                </div>
            }
        </div>

        <hr />

        <!-- Outgoing Requests -->
        <div>
            <h5 class="fw-bold mb-3">Outgoing Friend Requests</h5>

            @if (outgoingRequests.Any())
            {
                @foreach (var req in outgoingRequests)
                {
                    <div class="card shadow-sm border-0 mb-2">
                        <div class="card-body d-flex justify-content-between align-items-center">

                            <strong>@req.Username</strong>

                            <span class="badge bg-warning text-dark">
                                Pending
                            </span>

                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-light text-center">
                    No outgoing requests.
                </div>
            }
        </div>

    </div>
</div>

<style>
    .card {
        transition: all 0.2s ease;
    }

        .card:hover {
            transform: translateY(-2px);
        }

    .friends-page .card-body {
        padding: 1rem 1.25rem;
    }

    .btn {
        border-radius: 10px;
    }

    .form-control {
        border-radius: 10px;
    }

    .badge {
        font-size: 0.85rem;
        padding: 0.6em 0.8em;
    }
</style>
@code {
    // Characters typed into the search box
    private string searchText = "";

    // Results from search
    private List<FullFriend> searchResults = new();

    // Accepted friends
    private List<FullFriend> friends = new();

    // Friend requested received
    private List<FullFriend> incomingRequests = new();

    // Friend requests sent
    private List<FullFriend> outgoingRequests = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadFriendData();
    }

    // Loads friend and request info 
    private async Task LoadFriendData()
    {
        await db.LoadData(Http);

        // Build friends list
        friends = db.FriendRequests
            .Where(r => r.Status == FriendRequestStatus.Accepted &&
                       (r.SenderID == UserLogin.UserID || r.ReceiverID == UserLogin.UserID))
            .Select(r => GetUser(r.SenderID == UserLogin.UserID ? r.ReceiverID : r.SenderID))
            .ToList();

        // Incoming pending
        incomingRequests = db.FriendRequests
            .Where(r => r.Status == FriendRequestStatus.Pending &&
                        r.ReceiverID == UserLogin.UserID)
            .Select(r => GetUser(r.SenderID))
            .ToList();

        // Outgoing pending
        outgoingRequests = db.FriendRequests
            .Where(r => r.Status == FriendRequestStatus.Pending &&
                        r.SenderID == UserLogin.UserID)
            .Select(r => GetUser(r.ReceiverID))
            .ToList();
    }

    private FullFriend GetUser(long id)
    {
        var user = db.Login.First(x => x.UserID == id);
        return new FullFriend { UserID = user.UserID, Username = user.Username };
    }

    // Searches database for users w/ inputted username
    private async Task SearchUsers()
    {
        await db.LoadData(Http);

        searchResults = db.Login
            .Where(x => x.Username.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                        && x.UserID != UserLogin.UserID 
                        && x.UserPermission == Permission.User)
            .Select(x => new FullFriend { UserID = x.UserID, Username = x.Username })
            .ToList();
    }

    // Sends friend request to another user
    public async Task AddFriend(FullFriend friend)
    {
        await db.LoadData(Http);

        db.FriendRequests.Add(new FriendRequest()
        {
            SenderID = UserLogin.UserID,
            ReceiverID = friend.UserID,
            Status = FriendRequestStatus.Pending
        });

        await db.SaveData(Http);
        await LoadFriendData();
    }

    // Accepts pending friend request
    public async Task AcceptFriend(FullFriend friend)
    {
        await db.LoadData(Http);

        var req = db.FriendRequests.FirstOrDefault(x =>
            x.SenderID == friend.UserID &&
            x.ReceiverID == UserLogin.UserID &&
            x.Status == FriendRequestStatus.Pending);

        if (req != null)
        {
            req.Status = FriendRequestStatus.Accepted;
            await db.SaveData(Http);
        }

        await LoadFriendData();
    }
    
    // Reject pending friend request
    public async Task RejectFriend(FullFriend friend)
    {
        await db.LoadData(Http);

        var req = db.FriendRequests.FirstOrDefault(x =>
            x.SenderID == friend.UserID &&
            x.ReceiverID == UserLogin.UserID &&
            x.Status == FriendRequestStatus.Pending);

        if (req != null)
        {
            req.Status = FriendRequestStatus.Rejected;
            await db.SaveData(Http);
        }

        await LoadFriendData();
    }

    // Checks if user is already in friend list
    private bool IsAlreadyFriends(long id) =>
        friends.Any(f => f.UserID == id);

    // Checks if a friend request exists
    private bool HasPendingRequest(long id) =>
        incomingRequests.Any(f => f.UserID == id) ||
        outgoingRequests.Any(f => f.UserID == id);

    public class FullFriend
    {
        public long UserID { get; set; }
        public string Username { get; set; }
    }
}