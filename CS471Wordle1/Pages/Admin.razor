@page "/admin"
@using WordleAPI.Classes
@using WordleBackend
@using WordleBackend.Classes
@using WordleBackend.Enums
@using WordleAPI
@inject Login UserLogin
@inject HttpClient Http
@inject DataBase db
@inject ValidWords ValidWords
@if (UserLogin.UserPermission == Permission.Admin)
{
    <div class="d-flex justify-content-center mt-5">
        <div class="card shadow-lg border-0 p-4" style="width: 1000px; border-radius: 15px;">

            <h2 class="text-center fw-bold mb-4">
                Admin Panel
            </h2>

            @if (isLoading)
            {
                <div class="text-center">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-2">Loading...</p>
                </div>
            }
            else
            {
                <div class="text-center text-danger mb-3">
                    @DailyWordMessage
                </div>

                <!-- Daily Word Management -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body">

                        <h4 class="fw-bold mb-3">
                            Daily Word Management
                        </h4>

                        <div class="row g-3 align-items-start">

                            <div class="col-md-3">
                                <label class="form-label">Date</label>
                                <input type="date"
                                       class="form-control"
                                       @bind="newDate" />
                            </div>

                            <div class="col-md-6 position-relative">
                                <label class="form-label">Word</label>

                                <input type="text"
                                       class="form-control"
                                       placeholder="Search word..."
                                       @bind="wordSearch"
                                       @oninput="FilterWords" />

                                @if (filteredWords.Any())
                                {
                                    <div class="list-group position-absolute w-100 shadow"
                                         style="z-index:1000; max-height:200px; overflow-y:auto;">

                                        @foreach (var w in filteredWords)
                                        {
                                            <button type="button"
                                                    class="list-group-item list-group-item-action"
                                                    @onclick="() => SelectWord(w)">
                                                @w
                                            </button>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">&nbsp;</label>
                                <button class="btn btn-success w-100"
                                        @onclick="AddRecord">
                                    Add Daily Word
                                </button>
                            </div>

                        </div>

                        <div class="table-responsive mt-4">
                            <table class="table table-hover align-middle">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Date</th>
                                        <th>Word</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var entry in db.DailyWords.OrderByDescending(r => r.Date))
                                    {
                                        <tr>
                                            <td>@entry.Date.ToString("yyyy-MM-dd")</td>
                                            <td>@entry.Word</td>

                                            <td>
                                                <button class="btn btn-danger btn-sm"
                                                        @onclick="() => DeleteRecord(entry)">
                                                    Delete
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>

                <!-- User Management -->
                <div class="card shadow-sm border-0">
                    <div class="card-body">

                        <h4 class="fw-bold mb-3">
                            User Management
                        </h4>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle">

                                <thead class="table-dark">
                                    <tr>
                                        <th>Username</th>
                                        <th>Permission</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var user in db.Login)
                                    {
                                        <tr>

                                            <td>
                                                <input class="form-control"
                                                       @bind="user.Username" />
                                            </td>

                                            <td>
                                                <select class="form-select"
                                                        @bind="user.UserPermission">

                                                    @foreach (var mode in Enum.GetValues(typeof(Permission)))
                                                    {
                                                        <option value="@mode">
                                                            @mode
                                                        </option>
                                                    }

                                                </select>
                                            </td>

                                            <td>
                                                <button class="btn btn-success btn-sm me-2"
                                                        @onclick="() => SaveUser(user)">
                                                    Save
                                                </button>

                                                <button class="btn btn-danger btn-sm"
                                                        @onclick="() => DeleteUser(user)">
                                                    Delete
                                                </button>
                                            </td>

                                        </tr>
                                    }
                                </tbody>

                            </table>
                        </div>

                    </div>
                </div>
            }
    </div>
</div>


}
else
{

    <div class="text-center mt-5">
        <div class="alert alert-danger d-inline-block">
            You do not have permission to access this page.
        </div>
    </div>
}

<style>
    .card {
        transition: all .2s ease;
    }

        .card:hover {
            transform: translateY(-2px);
        }

    .btn {
        border-radius: 10px;
    }

    .form-control,
    .form-select {
        border-radius: 10px;
    }

    .table {
        margin-bottom: 0;
    }

    .table-dark th {
        border: none;
    }

    .list-group {
        border-radius: 10px;
    }

    .list-group-item:hover {
        background-color: #f8f9fa;
    }
</style>

@code {
    private DateOnly newDate = DateOnly.FromDateTime(DateTime.Now);
    private string newWord = "";
    private bool isLoading = true;
    private List<string> AvailableWords = new();

    private string wordSearch = "";
    private List<string> filteredWords = new();
	private string DailyWordMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        await ValidWords.LoadValidWords(Http);
        AvailableWords = ValidWords.AllWords.Where(w => w.CanUse).Select(w => w.Word).ToList();
    }

    private async Task LoadData()
    {
        isLoading = true;
        await db.LoadData(Http);
        newDate = GetFirstAvailableDate();

        isLoading = false;
    }

    private DateOnly GetFirstAvailableDate()
    {
        var yesterday = DateOnly.FromDateTime(DateTime.Today).AddDays(-1);

        // Get all scheduled dates after today
        var usedDates = db.DailyWords
            .Where(r => r.Date > yesterday)
            .Select(r => r.Date)
            .ToHashSet();

        // Start checking tomorrow
        var check = yesterday.AddDays(1);

        // Increment until we find a free date
        while (usedDates.Contains(check))
        {
            check = check.AddDays(1);
        }

        return check;
    }

    private void FilterWords(ChangeEventArgs e)
    {
        wordSearch = e.Value?.ToString() ?? "";

        if (string.IsNullOrWhiteSpace(wordSearch))
        {
            filteredWords.Clear();
            return;
        }

        filteredWords = AvailableWords
            .Where(w => w.StartsWith(wordSearch, StringComparison.OrdinalIgnoreCase))
            .Take(20)
            .ToList();
    }

    private void SelectWord(string word)
    {
        newWord = word;
        wordSearch = word;
        filteredWords.Clear();
    }

    private async Task AddRecord()
    {
        await db.LoadData(Http);
        if (string.IsNullOrWhiteSpace(newWord))
		{
			DailyWordMessage = "Please enter a valid word.";
            return;
        }
        if (db.DailyWords.Any(d => d.Date == newDate))
        {
            // Handle duplicate date case
			DailyWordMessage = "A word is already scheduled for this date.";
            return;
        }

        db.DailyWords.Add(new DailyWords
        {
            Date = newDate,
            Word = newWord.Trim().ToLower()
        });

		await db.SaveData(Http);

        newWord = "";
		wordSearch = "";
		filteredWords.Clear();
		newDate = GetFirstAvailableDate();
    }

    private async Task DeleteRecord(DailyWords entry)
    {
		//await db.LoadData(Http);
        db.DailyWords.Remove(entry);
		await db.SaveData(Http);
        DailyWordMessage = $"Succesfully removed {entry.Word}.";
    }

    private async Task SaveUser(Login user)
    {
		db.UpdateUserData(user);
		await db.SaveData(Http);
    }

    private async Task DeleteUser(Login user)
    {
		db.Login.Remove(user);
        db.FriendRequests.RemoveAll(r => r.SenderID == user.UserID || r.ReceiverID == user.UserID);
		await db.SaveData(Http);
    }
}