@using CS471Wordle1.Pages.Components
@using WordleAPI.Classes
@using WordleBackend.Enums
@inject Login UserLogin
@page "/stats"
<div class="d-flex justify-content-center mt-5">
    <div class="card shadow-lg border-0 p-4"
         style="width: 1200px; border-radius: 15px;">

        <h2 class="text-center fw-bold mb-4">
            Statistics & Leaderboards
        </h2>

        <div class="row g-4">

            @if (UserLogin.UserPermission != Permission.Guest)
            {
                <div class="col-lg-5">
                    <StatsViewer />
                </div>
            }

            <div class="col-lg-7">

                <Leaderboard IsFriendsOnly="false" />

                @if (UserLogin.UserPermission != Permission.Guest)
                {
                    <div class="mt-4">
                        <Leaderboard IsFriendsOnly="true" />
                    </div>
                }

            </div>

        </div>

    </div>
</div>

<style>
    .card {
        transition: all .2s ease;
    }

        .card:hover {
            transform: translateY(-2px);
        }

    .table {
        margin-bottom: 0;
    }

    .table-dark th {
        border: none;
    }

    .table td,
    .table th {
        vertical-align: middle;
    }

    .alert {
        border-radius: 10px;
    }
</style>

@code {

    // Displays user statistics and leaderboard info
    // Guests can only view global leaderboards
    // Users can view personal stats and friend + global leaderboards

}